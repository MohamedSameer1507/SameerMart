erDiagram
    USERS ||--o{ PRODUCTS : "sells"
    USERS ||--o| CART : "owns"
    USERS ||--o{ ORDERS : "places"
    USERS ||--o{ REVIEWS : "writes"

    CART ||--o{ CART_ITEMS : "contains"
    PRODUCTS ||--o{ CART_ITEMS : "referenced_in"

    ORDERS ||--|{ ORDER_ITEMS : "contains"
    PRODUCTS ||--o{ ORDER_ITEMS : "included_in"

    PRODUCTS ||--o{ REVIEWS : "receives"

    USERS {
        INT id PK "GENERATED BY DEFAULT AS IDENTITY"
        VARCHAR(100) name "NOT NULL"
        VARCHAR(150) email "NOT NULL, UNIQUE"
        VARCHAR(255) password "NOT NULL (BCrypt hashed)"
        VARCHAR(30) role "NOT NULL (BUYER, SELLER, ADMIN)"
    }

    PRODUCTS {
        INT id PK "GENERATED BY DEFAULT AS IDENTITY"
        INT seller_id FK "NOT NULL -> USERS(id)"
        VARCHAR(150) name "NOT NULL"
        VARCHAR(1000) description "Nullable"
        VARCHAR(100) category "NOT NULL"
        DECIMAL(12_2) price "NOT NULL"
        INT quantity "NOT NULL, >= 0"
        VARCHAR(255) image_url "DEFAULT 'default-product.svg'"
        BOOLEAN active "NOT NULL, DEFAULT TRUE"
        TIMESTAMP created_at "DEFAULT CURRENT_TIMESTAMP"
    }

    CART {
        INT id PK "GENERATED BY DEFAULT AS IDENTITY"
        INT buyer_id FK "NOT NULL, UNIQUE -> USERS(id)"
        TIMESTAMP created_at "DEFAULT CURRENT_TIMESTAMP"
    }

    CART_ITEMS {
        INT id PK "GENERATED BY DEFAULT AS IDENTITY"
        INT cart_id FK "NOT NULL -> CART(id) ON DELETE CASCADE"
        INT product_id FK "NOT NULL -> PRODUCTS(id) ON DELETE CASCADE"
        INT quantity "NOT NULL, > 0"
    }

    ORDERS {
        INT id PK "GENERATED BY DEFAULT AS IDENTITY"
        INT buyer_id FK "NOT NULL -> USERS(id)"
        DECIMAL(12_2) total_amount "NOT NULL"
        VARCHAR(50) status "DEFAULT 'CONFIRMED' (PENDING, CONFIRMED, SHIPPED, DELIVERED, CANCELLED)"
        TIMESTAMP created_at "DEFAULT CURRENT_TIMESTAMP"
    }

    ORDER_ITEMS {
        INT id PK "GENERATED BY DEFAULT AS IDENTITY"
        INT order_id FK "NOT NULL -> ORDERS(id) ON DELETE CASCADE"
        INT product_id FK "NOT NULL -> PRODUCTS(id)"
        INT quantity "NOT NULL, > 0"
        DECIMAL(12_2) price "NOT NULL (Snapshot price at checkout)"
    }

    REVIEWS {
        INT id PK "GENERATED BY DEFAULT AS IDENTITY"
        INT product_id FK "NOT NULL -> PRODUCTS(id) ON DELETE CASCADE"
        INT buyer_id FK "NOT NULL -> USERS(id)"
        INT rating "NOT NULL, 1 to 5 stars"
        VARCHAR(500) review_text "Sanitized comment text"
        TIMESTAMP created_at "DEFAULT CURRENT_TIMESTAMP"
    }
