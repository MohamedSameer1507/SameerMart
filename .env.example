# SameerMart Environment Configuration Template
# Copy this file to .env for local runtime execution (do NOT commit .env).

# Database Configuration (Defaults to local embedded H2 if unset)
DB_URL=jdbc:h2:./data/sameermart
DB_USER=sa
DB_PASSWORD=

# Product Upload Directory (Stored outside exploded WAR for persistence)
SAMEERMART_UPLOAD_DIR=./data/product-images

# Seeded Admin Account Configuration
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@sameermart.com
ADMIN_PASSWORD=admin123

# AI Chatbot Configuration
# Options: 'mock' (default, canned FAQ responses) or 'gemini' (live Google Gemini API)
AI_CHATBOT_PROVIDER=mock

# Google Gemini API Settings (Required only when AI_CHATBOT_PROVIDER=gemini)
# Default model: gemini-3.1-flash-lite (Free tier, stable). Do NOT use deprecated gemini-2.5-* models.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
